    "axios": "^1.15.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "garmin-connect": "^1.6.2",
    "impit": "^0.14.3",
    "jsonrepair": "^3.14.0",
    "oauth-1.0a": "^2.2.6",
    "tough-cookie": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
