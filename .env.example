# Single env file for the whole workspace:
# - apps/server reads it via `tsx watch --env-file=../../.env`
# - apps/client (Vite) reads it via `envDir: "../../"` (VITE_* vars only)
# - docker-compose reads POSTGRES_* for the local Postgres container

# ── Database ──────────────────────────────────────────────────────────
# Matches the docker-compose defaults; database is created by scripts/init-db.sql.
DATABASE_URL=postgresql://platform:platform@localhost:5432/fitness_meal_planner_db
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform

# ── Clerk auth ────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Server ────────────────────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# NODE_ENV=production  # set in deployed environments only

# ── Client ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ── Gemini generation (see README for the full tunables table) ───────
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=
# GEMINI_TIMEOUT_MS=90000
# GEMINI_RETRIES=2
# GEMINI_MACRO_CHECK=true
# GEMINI_MACRO_CALORIE_TOLERANCE_PCT=12
# GEMINI_MACRO_PROTEIN_TOLERANCE_PCT=15
# GEMINI_MACRO_MAX_DAYS=3
# GENERATION_RATE_MAX=15
# GENERATION_RATE_WINDOW_MS=300000

# ── Garmin integration (optional) ─────────────────────────────────────
# Encrypts stored Garmin OAuth tokens at rest (AES-256-GCM). Required only if
# users link a Garmin account; the rest of the app runs fine without it.
# Generate with: openssl rand -base64 32
# GARMIN_TOKEN_ENC_KEY=
